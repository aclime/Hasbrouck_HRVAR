 ", ",
 StyleBox["\[ScriptCapitalL]x", "Input"],
 ", and ",
 StyleBox["\[ScriptCapitalL]y", "Input"],
 "; for ",
 StyleBox["X[5,\[ScriptCapitalL]x]", "Input"],
 " and ",
