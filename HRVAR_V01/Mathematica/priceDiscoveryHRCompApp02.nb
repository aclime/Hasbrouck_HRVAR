     ",", "dy_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "ka", ",", "kb", ",", "z"}], "}"}], ",", 
