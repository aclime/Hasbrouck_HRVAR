  FormBox[
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["x", "t"], ",", 
     SubscriptBox["y", "t"]}], "}"}], TraditionalForm]]],
 ", consider a standard linear lagged regression model:"
}], "Text",
