     RowBox[{
      RowBox[{"z", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"dx", "+", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"dy", "+", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"k", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", "+", "b"}], ")"}], "-", 
        RowBox[{"(", 
